// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String
  bio         String?
  location    String?
  avatarUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  companies          Company[]
  passwordCredential PasswordCredential?
}

model PasswordCredential {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  passwordHash     String
  refreshTokenHash String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  name           String
  normalizedName String
  website        String?
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs           Job[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

model Job {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  positionName   String
  location       String?
  platform       String
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String    @default("JPY")
  url            String?
  status         JobStatus @default(WISHLIST)
  notes          String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  interviews      Interview[]
  statusHistories JobStatusHistory[]

  @@index([companyId])
  @@index([status])
  @@index([updatedAt])
}

model Interview {
  id                String        @id @default(uuid()) @db.Uuid
  jobId             String        @db.Uuid
  round             JobStatus
  previousJobStatus JobStatus?
  mode              InterviewMode
  scheduledAt       DateTime      @db.Timestamptz(3)
  platform          String?
  meetingUrl        String?
  meetingId         String?
  meetingPassword   String?
  location          String?
  notes             String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([scheduledAt])
}

model JobStatusHistory {
  id         String              @id @default(uuid()) @db.Uuid
  jobId      String              @db.Uuid
  fromStatus JobStatus
  toStatus   JobStatus
  changeType JobStatusChangeType
  reason     String?
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

enum InterviewMode {
  ONLINE
  OFFLINE
}

enum JobStatusChangeType {
  ADVANCE
  CORRECTION
  UNDO
}

enum JobStatus {
  WISHLIST
  APPLIED
  DOCUMENT_SCREENING
  FIRST_INTERVIEW
  SECOND_INTERVIEW
  THIRD_INTERVIEW
  FINAL_INTERVIEW
  OFFER
  REJECTED
}
